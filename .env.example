APP_ENV=development
# Enable the privacy-safe, allowlisted alpha diagnostics events locally.
VITE_ALPHA_DIAGNOSTICS=true
# Supabase Auth configuration (use Cloudflare deployment variables/secrets for real values).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_REDIRECT_URL=http://localhost:8788/
# Providers are opt-in per deployed build. Never enable one before its Supabase provider is working.
VITE_AUTH_GOOGLE_ENABLED=true
VITE_AUTH_APPLE_ENABLED=false
VITE_AUTH_EMAIL_ENABLED=false
