{
  "name": "cradle-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pages": "wrangler pages dev dist --d1=DB=cradle-db",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply cradle-db --local",
    "db:migrations:list": "wrangler d1 migrations list cradle-db --local",
    "db:reset:local": "node scripts/reset-local-d1.mjs",
    "preview:cloudflare": "wrangler pages dev dist --d1=DB=cradle-db",
    "validate": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^7.0.6",
    "typescript": "~5.8.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260721.1",
    "@eslint/js": "^9.31.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.26.1"
  }
}
